<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>
  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%= listing.image %>"
      alt="listing_image"
      class="card-img-top show-img"
    />

    <div class="card-body">
      <p class="card-text">
        <%= listing.description %> <br />
        &#8377; <%= listing.price.toLocaleString("en-IN") %> / Night <br />

        <%= listing.location %> <br />
        <%= listing.country %>
      </p>
    </div>
  </div>

  <br />
  <div class="btns">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark col-0.99 offset-3 edit-btn"
      >Edit</a
    >

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
      <button type="submit" class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>

  <!-- Review -->
  <div class="col-6 offset-3 md-3">
    <hr />
    <h6><b>Leave a Review</b></h6>
    <form
      action="/listings/<%= listing.id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <div class="mb-3 mt-3">
        <label for="rating" class="form-lable">Rating</label>
        <input
          type="range"
          name="review[rating]"
          id="rating"
          min="1"
          max="5"
          class="form-range"
          required
        />
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="50"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr />
    <!-- Show Review -->
    <h6><b>All Review</b></h6>
    <div class="row">
      <% for(review of listing.reviews) { %>
        <div class=" card col-sm-5 ms-3 mb-sm-3">
            <div class="card-body">
              <h5 class="card-title">Mukul</h5>
              <p class="card-text"><%= review.comment %></p>
              <p class="card-text"><%= review.rating %> stars</p>
              <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            </div>
        </div>
      <% } %>
    </div>

  </div>
</div>
