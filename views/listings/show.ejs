<% layout("/layouts/boilerplate") %>
<div class="container mt-3 mb-4">
  <div class="row col-12 offset-1 card-position">
    <div class="col-lg-10 col-md-8">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">
          <div class="card col-8 show-card listing-card">
            <div>
              <div class="col-8 mt-4 mb-2">
                <h3 class="show-heading"><%= listing.title %></h3>
              </div>
              <img
                src="<%= listing.image.url || listing.image %>"
                class="card-img-top show-img"
                alt="listing_image"
              />
              <p class="show-text ryt-p">
                ~&nbsp;<i>@<%= listing.owner.username %></i>
              </p>
              <p class="show-text">&#8226; <%= listing.description %></p>
              <p class="show-text">
                &#8226; Price : &#8377; <%=
                listing.price.toLocaleString("en-IN") %> / night
              </p>
              <p class="show-text">
                &#8226; Location : <%= listing.location %>
              </p>
              <p class="show-text">&#8226; Country : <%= listing.country %></p>
              <p class="show-text">
                &#8226; Category : <%= listing.category %>
              </p>

              <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
              <div class="btns btn-outline-dark mt-3">
                <a
                  href="/listings/<%= listing._id %>/edit"
                  class="btn add-btn edit-btn"
                  >Edit</a
                >
                <form
                  method="POST"
                  action="/listings/<%=listing._id%>?_method=DELETE"
                >
                  <button class="btn offset-3 dlt-btn">Delete</button>
                </form>
              </div>
            </div>

            <div class="col-12 mb-3">
              <% } %> <% if(currUser) { %>
              <hr />
              <h4 class="show-heading">Leave a Review</h4>
              <form
                action="/listings/<%=listing._id%>/reviews"
                method="POST"
                novalidate
                class="needs-validation"
              >
                <div class="mb-3 mt-3">
                  <label for="rating" class="form-label show-text"
                    >Rating</label
                  >
                  <fieldset class="starability-slot">
                    <input
                      type="radio"
                      id="no-rate"
                      class="input-no-rate"
                      name="review[rating]"
                      value="1"
                      checked
                      aria-label="No rating."
                    />
                    <input
                      type="radio"
                      id="first-rate1"
                      name="review[rating]"
                      value="1"
                    />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input
                      type="radio"
                      id="first-rate2"
                      name="review[rating]"
                      value="2"
                    />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input
                      type="radio"
                      id="first-rate3"
                      name="review[rating]"
                      value="3"
                    />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input
                      type="radio"
                      id="first-rate4"
                      name="review[rating]"
                      value="4"
                    />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input
                      type="radio"
                      id="first-rate5"
                      name="review[rating]"
                      value="5"
                    />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>
                <div class="mb-3 mt-3">
                  <label for="comment" class="form-label show-text"
                    >Comments</label
                  >
                  <textarea
                    name="review[comment]"
                    id="comment"
                    cols="30"
                    rows="5"
                    class="form-control"
                    required
                  ></textarea>
                  <div class="invalid-feedback">
                    * Please add some comments for review
                  </div>
                </div>
                <button class="btn add-btn">Submit</button>
                <button type="reset" class="btn reset-btn ms-3">Reset</button>
              </form>

              <% } %> <% if (listing.reviews.length > 0) { %>
              <hr />
              <div class="row">
                <p><b>All Reviews</b></p>
                <% for(review of listing.reviews) { %>
                <div class="card col-5 ms-3 mb-3">
                  <h5 class="card-title mt-2 author-name">
                    @<%= review.author.username %>&nbsp;&nbsp;
                    <p class="time-info">
                      ( <%= review.createdAt.toString().split(" ").slice(0,
                      4).join("-")%> )
                    </p>
                  </h5>
                  <p
                    class="starability-result show-text"
                    data-rating="<%= review.rating %>"
                  ></p>
                  <p class="show-text"><%= review.comment %></p>
                  <form
                    class="mb-3"
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  >
                    <% if(currUser && review.author.equals(currUser._id)) { %>
                    <div class="ryt-btn">
                      <button class="btn btn-sm dlt-btn">Delete</button>
                    </div>
                    <% } %>
                  </form>
                </div>
                <% } %>
              </div>
              <% } %>
            </div>
            <hr />

            <div>
              <h3 class="mb-3 show-heading">Where you'll be</h3>
              <div id="searchBox">
                <input
                  type="text"
                  class="search-inp map-inp"
                  id="address"
                  placeholder="Search Location"
                />
                <button
                  onclick="searchLocation()"
                  class="btn search-btn"
                  type="submit"
                >
                  <i class="fa-solid fa-magnifying-glass"></i><b>Search</b>
                </button>
              </div>
              <div id="map"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const listingLocation = "<%= listing.location %>";
</script>
<script src="/js/map.js"></script>