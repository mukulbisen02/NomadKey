<% layout ("layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8">
    <h3>Create New Listing</h3>
    <form action="/listings" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input
          type="text"
          id="title"
          name="listing[title]"
          required
          placeholder="Enter a Title"
          class="form-control"
        />
        <div class="valid-feedback">Title Looks good!</div>
        <div class="invalid-feedback">Please choose a Title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea
          id="description"
          name="listing[description]"
          required
          placeholder="Enter a description"
          class="form-control"
        ></textarea>
        <div class="valid-feedback">Description Looks good!</div>
        <div class="invalid-feedback">Please fill the Description.</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image URL:</label>
        <input
          type="text"
          id="image"
          name="listing[image]"
          placeholder="Enter Image URL"
          class="form-control"
        />
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="price" class="form-label">Price:</label>
          <input
            
            id="price"
            name="listing[price]"
            required
            placeholder="1500"
            class="form-control"
          />
          <div class="valid-feedback">Good!</div>
          <div class="invalid-feedback">Please choose a Price.</div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="country" class="form-label">Country:</label>
          <input
            type="text"
            id="country"
            name="listing[country]"
            required
            placeholder="India"
            class="form-control"
          />
          <div class="valid-feedback">Nice!</div>
          <div class="invalid-feedback">Please provide the vailid Country.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input
          type="text"
          id="location"
          name="listing[location]"
          required
          placeholder="Delhi, Mumbai"
          class="form-control"
        />
        <div class="valid-feedback">Nice!</div>
        <div class="invalid-feedback">Please provide the vailid Location.</div>
      </div>

      <button type="submit" class="btn btn-dark add-btn mt-3">Add</button>
    </form>
  </div>
</div>
